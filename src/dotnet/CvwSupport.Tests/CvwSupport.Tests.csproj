<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests of the backend's design-time document. Not part of CvwSupport.sln, so the plugin build does not need them:
       dotnet test src/dotnet/CvwSupport.Tests -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../CvwSupport/CvwMarkupMask.cs" Link="Backend/CvwMarkupMask.cs" />
    <Compile Include="../CvwSupport/CvwFileParser.cs" Link="Backend/CvwFileParser.cs" />
    <Compile Include="../CvwSupport/CvwGeneratedDocumentFactory.cs" Link="Backend/CvwGeneratedDocumentFactory.cs" />
    <Compile Remove="TestData/**" />
    <None Include="TestData/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" />
    <!-- The framework the design-time documents are compiled against -->
    <PackageReference Include="ConsoleMVC.Framework" Version="1.33.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <!-- Where the package's real source generator is, to compare the design-time documents with what it generates -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ConsoleMvcGenerator</_Parameter1>
      <_Parameter2>$(NuGetPackageRoot)consolemvc.framework/1.33.0/analyzers/dotnet/cs/ConsoleMVC.Generators.dll</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
