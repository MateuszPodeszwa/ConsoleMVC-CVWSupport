<idea-plugin>
    <id>com.github.mateuszpodeszwa.consolemvc.cvwsupport</id>
    <name>ConsoleMVC CvwSupport</name>
    <vendor url="https://github.com/MateuszPodeszwa">Mateusz Podeszwa</vendor>

    <description><![CDATA[
        Provides IDE support for ConsoleMVC .cvw (Console View) files in JetBrains Rider.
        Includes syntax highlighting, code completion, and navigation for the ConsoleMVC framework.
    ]]></description>

    <depends>com.intellij.modules.rider</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileType
            name="CVW"
            implementationClass="com.github.mateuszpodeszwa.consolemvc.cvwsupport.CvwFileType"
            fieldName="INSTANCE"
            language="CVW"
            extensions="cvw"/>

        <lang.parserDefinition
            language="CVW"
            implementationClass="com.github.mateuszpodeszwa.consolemvc.cvwsupport.parser.CvwParserDefinition"/>

        <lang.syntaxHighlighterFactory
            language="CVW"
            implementationClass="com.github.mateuszpodeszwa.consolemvc.cvwsupport.highlighting.CvwSyntaxHighlighterFactory"/>

        <completion.contributor
            language="CVW"
            implementationClass="com.github.mateuszpodeszwa.consolemvc.cvwsupport.completion.CvwCompletionContributor"/>

        <annotator
            language="CVW"
            implementationClass="com.github.mateuszpodeszwa.consolemvc.cvwsupport.annotator.CvwAnnotator"/>

        <lang.braceMatcher
            language="CVW"
            implementationClass="com.github.mateuszpodeszwa.consolemvc.cvwsupport.CvwBraceMatcher"/>

        <lang.commenter
            language="CVW"
            implementationClass="com.github.mateuszpodeszwa.consolemvc.cvwsupport.CvwCommenter"/>

        <liveTemplateContext
            implementation="com.github.mateuszpodeszwa.consolemvc.cvwsupport.CvwLiveTemplateContext"/>

        <defaultLiveTemplates file="/liveTemplates/CvwTemplates"/>

        <internalFileTemplate name="ConsoleMVC View.cvw"/>

        <codeInsight.lineMarkerProvider
            language="CVW"
            implementationClass="com.github.mateuszpodeszwa.consolemvc.cvwsupport.navigation.CvwViewLineMarkerProvider"/>

        <gotoRelatedProvider
            implementation="com.github.mateuszpodeszwa.consolemvc.cvwsupport.navigation.CvwGotoRelatedProvider"/>

        <lang.psiStructureViewFactory
            language="CVW"
            implementationClass="com.github.mateuszpodeszwa.consolemvc.cvwsupport.structure.CvwStructureViewFactory"/>

        <editorTabTitleProvider
            implementation="com.github.mateuszpodeszwa.consolemvc.cvwsupport.CvwEditorTabTitleProvider"/>
    </extensions>

    <actions>
        <action id="ConsoleMVC.NewCvwFile"
                class="com.github.mateuszpodeszwa.consolemvc.cvwsupport.CvwCreateFileAction">
            <add-to-group group-id="NewGroup" anchor="after" relative-to-action="NewFile"/>
        </action>
    </actions>
</idea-plugin>
