<idea-plugin>
    <id>com.github.mateuszpodeszwa.consolemvc.cvwsupport</id>
    <name>ConsoleMVC CvwSupport</name>
    <vendor url="https://github.com/MateuszPodeszwa">Mateusz Podeszwa</vendor>

    <description><![CDATA[
        Provides IDE support for ConsoleMVC .cvw (Console View) files in JetBrains Rider:
        C-View Markup highlighting, completion, documentation and checks, a live preview, and navigation.
    ]]></description>

    <depends>com.intellij.modules.rider</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileType
            name="CVW"
            implementationClass="com.github.mateuszpodeszwa.consolemvc.cvwsupport.CvwFileType"
            fieldName="INSTANCE"
            language="CVW"
            extensions="cvw"/>

        <lang.parserDefinition
            language="CVW"
            implementationClass="com.github.mateuszpodeszwa.consolemvc.cvwsupport.parser.CvwParserDefinition"/>

        <lang.syntaxHighlighterFactory
            language="CVW"
            implementationClass="com.github.mateuszpodeszwa.consolemvc.cvwsupport.highlighting.CvwSyntaxHighlighterFactory"/>

        <completion.contributor
            language="CVW"
            implementationClass="com.github.mateuszpodeszwa.consolemvc.cvwsupport.completion.CvwCompletionContributor"/>

        <annotator
            language="CVW"
            implementationClass="com.github.mateuszpodeszwa.consolemvc.cvwsupport.annotator.CvwAnnotator"/>

        <annotator
            language="CVW"
            implementationClass="com.github.mateuszpodeszwa.consolemvc.cvwsupport.annotator.CvwModelMismatchAnnotator"/>

        <!-- C-View Markup: checks from cvw-preview or the schema, completion pop-ups and the preview window -->
        <externalAnnotator
            language="CVW"
            implementationClass="com.github.mateuszpodeszwa.consolemvc.cvwsupport.annotator.CvwMarkupAnnotator"/>

        <typedHandler implementation="com.github.mateuszpodeszwa.consolemvc.cvwsupport.completion.CvwTypedHandler"/>

        <toolWindow
            id="ConsoleMVC Preview"
            anchor="right"
            secondary="false"
            icon="/icons/cvw.svg"
            canCloseContents="false"
            factoryClass="com.github.mateuszpodeszwa.consolemvc.cvwsupport.preview.CvwPreviewToolWindowFactory"/>

        <applicationConfigurable
            parentId="tools"
            id="consolemvc.settings"
            displayName="ConsoleMVC"
            instance="com.github.mateuszpodeszwa.consolemvc.cvwsupport.settings.CvwSettingsConfigurable"/>

        <lang.braceMatcher
            language="CVW"
            implementationClass="com.github.mateuszpodeszwa.consolemvc.cvwsupport.CvwBraceMatcher"/>

        <lang.commenter
            language="CVW"
            implementationClass="com.github.mateuszpodeszwa.consolemvc.cvwsupport.CvwCommenter"/>

        <liveTemplateContext
            implementation="com.github.mateuszpodeszwa.consolemvc.cvwsupport.CvwLiveTemplateContext"/>

        <defaultLiveTemplates file="/liveTemplates/CvwTemplates"/>

        <internalFileTemplate name="ConsoleMVC View.cvw"/>

        <codeInsight.lineMarkerProvider
            language="CVW"
            implementationClass="com.github.mateuszpodeszwa.consolemvc.cvwsupport.navigation.CvwViewLineMarkerProvider"/>

        <gotoRelatedProvider
            implementation="com.github.mateuszpodeszwa.consolemvc.cvwsupport.navigation.CvwGotoRelatedProvider"/>

        <lang.psiStructureViewFactory
            language="CVW"
            implementationClass="com.github.mateuszpodeszwa.consolemvc.cvwsupport.structure.CvwStructureViewFactory"/>

        <editorTabTitleProvider
            implementation="com.github.mateuszpodeszwa.consolemvc.cvwsupport.CvwEditorTabTitleProvider"/>

        <lang.foldingBuilder
            language="CVW"
            implementationClass="com.github.mateuszpodeszwa.consolemvc.cvwsupport.folding.CvwFoldingBuilder"/>

        <colorSettingsPage
            implementation="com.github.mateuszpodeszwa.consolemvc.cvwsupport.highlighting.CvwColorSettingsPage"/>

        <lang.documentationProvider
            language="CVW"
            implementationClass="com.github.mateuszpodeszwa.consolemvc.cvwsupport.documentation.CvwDocumentationProvider"/>

        <extendWordSelectionHandler
            implementation="com.github.mateuszpodeszwa.consolemvc.cvwsupport.editor.CvwWordSelectionHandler"/>
    </extensions>

    <actions>
        <action id="ConsoleMVC.ShowPreview"
                class="com.github.mateuszpodeszwa.consolemvc.cvwsupport.preview.CvwShowPreviewAction"
                text="Show ConsoleMVC Preview"
                description="Shows the view drawn by cvw-preview in the ConsoleMVC Preview tool window"
                icon="/icons/cvw.svg">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="shift ctrl alt V"/>
        </action>

        <action id="ConsoleMVC.NewCvwFile"
                class="com.github.mateuszpodeszwa.consolemvc.cvwsupport.CvwCreateFileAction">
            <add-to-group group-id="NewGroup" anchor="after" relative-to-action="NewFile"/>
        </action>
    </actions>
</idea-plugin>
