<templateSet group="CVW">
    <template name="cvw"
              value="@model $MODEL_TYPE$&#10;&#10;&lt;box title=&quot;$TITLE$&quot; class=&quot;panel&quot;&gt;&#10;    &lt;text&gt;$TEXT$&lt;/text&gt;&#10;&lt;/box&gt;&#10;&lt;br /&gt;&#10;&#10;&lt;menu&gt;&#10;    &lt;option key=&quot;1&quot; nav=&quot;$NAV$&quot;&gt;$OPTION$&lt;/option&gt;&#10;    &lt;option key=&quot;q&quot; quit&gt;Exit&lt;/option&gt;&#10;&lt;/menu&gt;&#10;$END$"
              description="A view with a model, a box and a menu"
              toReformat="false"
              toShortenFQNames="false">
        <variable name="MODEL_TYPE" expression="" defaultValue="&quot;MyApp.Models.HomeViewModel&quot;" alwaysStopAt="true"/>
        <variable name="TITLE" expression="" defaultValue="&quot;@Model.Title&quot;" alwaysStopAt="true"/>
        <variable name="TEXT" expression="" defaultValue="&quot;@Model.Message&quot;" alwaysStopAt="true"/>
        <variable name="NAV" expression="" defaultValue="&quot;Home/About&quot;" alwaysStopAt="true"/>
        <variable name="OPTION" expression="" defaultValue="&quot;About&quot;" alwaysStopAt="true"/>
        <context>
            <option name="OTHER" value="true"/>
        </context>
    </template>

    <template name="cvwform"
              value="&lt;errors /&gt;&#10;&#10;&lt;input name=&quot;$NAME$&quot; label=&quot;$LABEL$&quot; required /&gt;&#10;$END$&#10;&#10;return NavigationResult.ToAction(&quot;$ACTION$&quot;, Form);"
              description="Fields that are posted to an action"
              toReformat="false"
              toShortenFQNames="false">
        <variable name="NAME" expression="" defaultValue="&quot;Name&quot;" alwaysStopAt="true"/>
        <variable name="LABEL" expression="" defaultValue="&quot;Name: &quot;" alwaysStopAt="true"/>
        <variable name="ACTION" expression="" defaultValue="&quot;Result&quot;" alwaysStopAt="true"/>
        <context>
            <option name="OTHER" value="true"/>
        </context>
    </template>

    <template name="cvwtable"
              value="&lt;table border=&quot;rounded&quot;&gt;&#10;    &lt;row header&gt;&lt;cell&gt;$HEADER$&lt;/cell&gt;&lt;/row&gt;&#10;    @foreach (var $ITEM$ in $ITEMS$)&#10;    {&#10;        &lt;row&gt;&lt;cell&gt;@$ITEM$.$PROPERTY$&lt;/cell&gt;&lt;/row&gt;&#10;    }&#10;&lt;/table&gt;&#10;$END$"
              description="A table with a header row and a row per item"
              toReformat="false"
              toShortenFQNames="false">
        <variable name="HEADER" expression="" defaultValue="&quot;Name&quot;" alwaysStopAt="true"/>
        <variable name="ITEM" expression="" defaultValue="&quot;item&quot;" alwaysStopAt="true"/>
        <variable name="ITEMS" expression="" defaultValue="&quot;Model.Items&quot;" alwaysStopAt="true"/>
        <variable name="PROPERTY" expression="" defaultValue="&quot;Name&quot;" alwaysStopAt="true"/>
        <context>
            <option name="OTHER" value="true"/>
        </context>
    </template>

    <template name="navto"
              value="NavigationResult.To(&quot;$CONTROLLER$&quot;, &quot;$ACTION$&quot;)"
              description="Navigate to controller action"
              toReformat="false"
              toShortenFQNames="false">
        <variable name="CONTROLLER" expression="" defaultValue="&quot;Home&quot;" alwaysStopAt="true"/>
        <variable name="ACTION" expression="" defaultValue="&quot;Index&quot;" alwaysStopAt="true"/>
        <context>
            <option name="OTHER" value="true"/>
        </context>
    </template>

    <template name="navaction"
              value="NavigationResult.ToAction(&quot;$ACTION$&quot;)"
              description="Navigate to action on current controller"
              toReformat="false"
              toShortenFQNames="false">
        <variable name="ACTION" expression="" defaultValue="&quot;Index&quot;" alwaysStopAt="true"/>
        <context>
            <option name="OTHER" value="true"/>
        </context>
    </template>

    <template name="navquit"
              value="NavigationResult.Quit()"
              description="Quit the application"
              toReformat="false"
              toShortenFQNames="false">
        <context>
            <option name="OTHER" value="true"/>
        </context>
    </template>
</templateSet>
